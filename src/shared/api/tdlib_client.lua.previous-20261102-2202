local base64_alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function encode_base64(bytes)
    local encoded = {}
    for index = 1, #bytes, 3 do
        local first, second, third = bytes:byte(index, index + 2)
        local value = (first or 0) * 65536 + (second or 0) * 256 + (third or 0)
        local first_index = math.floor(value / 262144) % 64 + 1
        local second_index = math.floor(value / 4096) % 64 + 1
        local third_index = math.floor(value / 64) % 64 + 1
        local fourth_index = value % 64 + 1
        encoded[#encoded + 1] = base64_alphabet:sub(first_index, first_index)
        encoded[#encoded + 1] = base64_alphabet:sub(second_index, second_index)
        encoded[#encoded + 1] = second and base64_alphabet:sub(third_index, third_index) or "="
        encoded[#encoded + 1] = third and base64_alphabet:sub(fourth_index, fourth_index) or "="
    end
    return table.concat(encoded)
end

